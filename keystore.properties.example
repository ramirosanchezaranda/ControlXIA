# Copiá este archivo como "keystore.properties" (no se commitea) y completá
# con los datos de tu keystore para firmar el APK/AAB release.
#
# Generar un keystore (una sola vez):
#   keytool -genkey -v -keystore controlxia-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias controlxia
#
# En CI podés usar variables de entorno en vez de este archivo:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=controlxia-release.jks
storePassword=CAMBIA_ESTO
keyAlias=controlxia
keyPassword=CAMBIA_ESTO
